#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Hook: Enforce Clang-Format on staged C++ files
# ==============================================================================
set -euo pipefail

# Find clang-format binary
CLANG_FORMAT=$(command -v clang-format || true)

if [ -z "$CLANG_FORMAT" ]; then
    echo "[HOOK ERROR] clang-format executable not found in PATH."
    echo "Please install clang-format or commit with --no-verify (not recommended)."
    exit 1
fi

# Retrieve staged files with C/C++ extensions (ignoring deleted files via --diff-filter=d)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(cpp|hpp|c|h)$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FAILED_FILES=()

for FILE in $STAGED_FILES; do
    # Skip files located in third-party or build directories if any are staged
    if [[ "$FILE" =~ ^(build|external|_deps)/ ]]; then
        continue
    fi

    # Dry-run format verification: exit code != 0 if file needs formatting
    if ! "$CLANG_FORMAT" --dry-run --Werror "$FILE" >/dev/null 2>&1; then
        FAILED_FILES+=("$FILE")
    fi
done

if [ ${#FAILED_FILES[@]} -ne 0 ]; then
    echo "===================================================================="
    echo "[HOOK ERROR] The following files violate clang-format style guide:"
    for FILE in "${FAILED_FILES[@]}"; do
        echo "  - $FILE"
    done
    echo ""
    echo "Fix formatting using one of the following commands:"
    echo "  1) Run CMake target: cmake --build <build-dir> --target format"
    echo "  2) Format directly:  clang-format -i <file>"
    echo "Then re-stage the changes with 'git add' and commit again."
    echo "===================================================================="
    exit 1
fi

exit 0